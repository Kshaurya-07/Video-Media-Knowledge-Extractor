# ====================================================================
# VYORA AI — Environment Variables Template
# ====================================================================

# Google Gemini API Key (Required for AI extraction & Q&A)
# Obtain your key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Configured / Preferred Gemini Model (Defaults to gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Model Discovery Cache TTL in seconds (Defaults to 3600 / 1 hour)
MODEL_CACHE_TTL_SECONDS=3600

# Backend Web Server Port (Defaults to 8000 locally, automatically provided by Render as $PORT)
PORT=8000

# Frontend API Base URL (Required for production Vite build pointing to backend)
# Example: https://vyora-backend.onrender.com/api
VITE_API_URL=http://localhost:8000
